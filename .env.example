# Supabase Postgres connection.
# These bare keys are what the current .env uses and are read from the file
# directly (not from the process environment), so they cannot collide with
# OS variables of the same name.
host=
port=5432
database=
user=
password=

# Alternatively, a single libpq URL, which takes precedence:
# FH_DATABASE_URL=postgresql://user:password@host:5432/postgres

# LLM for constraint extraction. Leave FH_LLM_MODEL empty to use the
# deterministic rule-based extractor -- the API is fully functional without it.
FH_LLM_MODEL=
FH_LLM_PROVIDER=
FH_LLM_API_KEY=

# Comma-free JSON list, e.g. ["https://example.com"]
# FH_ALLOWED_ORIGINS=["http://localhost:3000"]
# FH_ENVIRONMENT=development
